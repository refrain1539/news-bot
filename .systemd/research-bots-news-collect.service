[Unit]
Description=Collect RSS articles for the news bot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=seiya
Group=seiya
WorkingDirectory=/home/seiya/services/news-bot
ExecStart=/usr/bin/flock -w 900 /home/seiya/services/news-bot/.run/bot.lock /home/seiya/services/news-bot/.venv/bin/python /home/seiya/services/news-bot/src/collect.py
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true

